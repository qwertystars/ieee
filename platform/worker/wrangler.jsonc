{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disaster-response-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "db",
      "database_name": "disaster-response-db",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "media",
      "bucket_name": "disaster-media"
    },
    {
      "binding": "exports",
      "bucket_name": "disaster-exports"
    }
  ],

  "queues": {
    "producers": [
      { "binding": "ingestQ", "queue": "ingest" },
      { "binding": "alertQ", "queue": "alert" },
      { "binding": "aiQ", "queue": "ai" },
      { "binding": "droneQ", "queue": "drone" },
      { "binding": "geocodeQ", "queue": "geocode" },
      { "binding": "webhookIngestQ", "queue": "webhook-ingest" },
      { "binding": "webhookDeliveryQ", "queue": "webhook-delivery" }
    ],
    "consumers": [
      {
        "queue": "ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ingest-dlq"
      },
      {
        "queue": "ingest-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "alert",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "alert-dlq"
      },
      {
        "queue": "alert-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      },
      {
        "queue": "ai",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "ai-dlq"
      },
      {
        "queue": "ai-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "drone",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "drone-dlq"
      },
      {
        "queue": "drone-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "geocode",
        "max_batch_size": 20,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "geocode-dlq"
      },
      {
        "queue": "geocode-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "webhook-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "webhook-ingest-dlq"
      },
      {
        "queue": "webhook-ingest-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "webhook-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "webhook-delivery-dlq"
      },
      {
        "queue": "webhook-delivery-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      }
    ]
  },

  "durable_objects": {
    "bindings": [
      { "name": "IncidentRoom", "class_name": "IncidentRoom" },
      { "name": "RateLimiter", "class_name": "RateLimiter" },
      { "name": "TaskTimer", "class_name": "TaskTimer" },
      { "name": "ShelterCounter", "class_name": "ShelterCounter" },
      { "name": "AmbulanceQueue", "class_name": "AmbulanceQueue" },
      { "name": "AgencyRoom", "class_name": "AgencyRoom" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IncidentRoom",
        "RateLimiter",
        "TaskTimer",
        "ShelterCounter",
        "AmbulanceQueue",
        "AgencyRoom"
      ]
    }
  ],

  "kv_namespaces": [
    { "binding": "cache", "id": "local-dev-placeholder-cache" },
    { "binding": "locales", "id": "local-dev-placeholder-locales" }
  ],

  "vectorize": [
    {
      "binding": "embeddings",
      "index_name": "disaster-embeddings"
    }
  ],

  "analytics_engine_datasets": [
    {
      "binding": "metrics",
      "dataset": "disaster_metrics"
    }
  ],

  "ai": {
    "binding": "ai"
  },

  "vars": {
    "ENVIRONMENT": "development"
  },

  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 * * * *",
      "0 2 * * *"
    ]
  },

  "env": {
    "staging": {
      "name": "disaster-response-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "disaster-response-worker-prod",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
