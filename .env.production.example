# ResQNet-SAGE — single-VM production configuration (docker-compose.prod.yml).
# Generate a filled-in .env with fresh secrets:  scripts/vm/init_env.sh https://resq.example.org
# Never commit the resulting .env.

# Lets plain `docker compose ...` (and scripts/backup.sh) target the prod stack.
COMPOSE_FILE=docker-compose.prod.yml

# Public origin. https://<domain> gets an automatic Let's Encrypt certificate;
# http://<vm-ip> serves plain HTTP (testing only).
PUBLIC_URL=https://resq.example.org

# Database (alphanumeric values only: they are embedded in DATABASE_URL)
POSTGRES_USER=resqnet
POSTGRES_PASSWORD=
POSTGRES_DB=resqnet

# Object storage. MinIO Inc. no longer publishes images (minio/minio is gone
# from Docker Hub), so pick an image you trust, pinned to a tag, e.g. the
# community fork pgsty/minio:RELEASE.2026-06-18T00-00-00Z (drop-in: same env,
# same `server /data`). See docs/DEPLOY_VM.md section 3.
MINIO_IMAGE=
MINIO_ACCESS_KEY=resqnet
MINIO_SECRET_KEY=

# JWT signing secret (>= 32 random characters)
JWT_SECRET=

# Uvicorn worker processes for the API (roughly 1 per vCPU, max 4 on one VM)
BACKEND_WORKERS=2
