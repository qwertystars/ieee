# ResQNet-SAGE Environment Configuration
#
# Copy to .env and adjust. All vars have defaults in backend/app/config.py
# except where noted. Docker Compose reads this file automatically.

# ── Database (PostgreSQL 16 + PostGIS + AGE + TimescaleDB + h3) ───────────────
POSTGRES_USER=local-dev-user
POSTGRES_PASSWORD=local-dev-db-password
POSTGRES_DB=local-dev-db
DATABASE_URL=postgresql+psycopg://local-dev-user:local-dev-db-password@db:5432/local-dev-db
# Local dev: postgresql+psycopg://local-dev-user:local-dev-db-password@localhost:5432/local-dev-db

# ── Redis (token denylist, rate limiting, caching) ───────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_REVOCATION_REQUIRED=true
REVOCATION_PROPAGATION_DEADLINE_SECONDS=60
REALTIME_FANOUT_CHANNEL=resqnet:realtime
EVALUATION_JOB_TTL_DAYS=7
RATE_LIMIT_WINDOW_SECONDS=60
# Local dev: redis://localhost:6379/0

# ── Redpanda / Kafka (event streaming) ───────────────────────────────────────
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092
# Override for external Kafka broker (checked before REDPANDA_BOOTSTRAP_SERVERS):
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MinIO (S3-compatible object storage for model weights) ───────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=local-dev-minio
MINIO_SECRET_KEY=local-dev-minio-secret

# ── Ollama (local LLM — evidence summarization, report parsing, translation) ─
OLLAMA_BASE_URL=http://ollama:11434
# Local dev: http://localhost:11434
# Pull model: ollama pull llama3.1:8b

# ── PMTiles (offline satellite/aerial basemap) ──────────────────────────────
# Path to a .pmtiles file for offline basemap. If unset, frontend falls back
# to vector tiles (solid dark background + vector overlays).
# Generate via: scripts/offline_prep.sh (requires tippecanoe)
# PMTILES_PATH=frontend/public/basemaps/rivertown.pmtiles

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=local-development-signing-secret-change-for-real-use
JWT_ALGORITHM=HS256
JWT_ISSUER=resqnet-sage
HUMAN_ACCESS_AUDIENCE=resqnet-api
DEVICE_ACCESS_AUDIENCE=resqnet-device
SERVICE_ACCESS_AUDIENCE=resqnet-service
REFRESH_TOKEN_AUDIENCE=resqnet-refresh
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DEVICE_ACCESS_TOKEN_EXPIRE_MINUTES=5
SERVICE_ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_ROTATION_REQUIRED=true
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=0

# ── CORS (comma-separated origins, or * for all in dev) ──────────────────────
CORS_ORIGINS=*
# Production: https://your-frontend-domain.example.com

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Set to "production" to enforce JWT_SECRET length and disable demo user seeding
UVICORN_RELOAD=false
SOURCE_MOUNTS_ENABLED=false
MOCK_BINDINGS_ENABLED=false
EXPOSE_INTERNAL_PORTS=false

# ── OpenTelemetry (distributed tracing) ──────────────────────────────────────
# Set to "none" to disable OTel entirely. Otherwise set an OTLP endpoint.
# OTEL_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000

# ── Grafana ──────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=local-dev-grafana-password
