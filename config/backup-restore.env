# Non-secret backup/recovery policy. Secret material is injected at runtime.
BACKUP_FREQUENCY_SECONDS=60
BACKUP_RETENTION_COUNT=30
BACKUP_ENCRYPTION_CIPHER=aes-256-cbc
BACKUP_ENCRYPTION_KEY_CUSTODY=external-secret-manager
BACKUP_KEY_REFERENCE=external-secret-manager://resqnet/backup
BACKUP_OFFSITE_REQUIRED=true
BACKUP_OFFSITE_PROVIDER=external-object-store
BACKUP_OFFSITE_STATUS=DEFERRED_EXTERNAL
BACKUP_RPO_TARGET_SECONDS=60
BACKUP_RTO_TARGET_SECONDS=900
BACKUP_RESTORE_ORDER=database,queue_offsets,model_manifests,audit_chain,objects,signing_key_escrow
